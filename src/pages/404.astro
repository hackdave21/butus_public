---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable | BUTUS" noindex bare>
  <div class="grid min-h-svh place-items-center bg-forest px-4 text-center text-white">
    <div>
      <p class="text-[clamp(3.5rem,14vw,8rem)] font-black leading-none tracking-tight"><span class="text-green">B</span>UTUS</p>
      <h1 class="mt-6 !text-[var(--text-step-3)]">Cette page n'existe pas</h1>
      <p class="mt-4 text-white/75">Le lien est peut-être erroné ou la page a été déplacée.</p>
      <a href="/" class="btn btn-yellow mt-8">Revenir à l'accueil</a>
    </div>
  </div>
</Base>
