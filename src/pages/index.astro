---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Loop from '../components/Loop.astro';
import Pillars from '../components/Pillars.astro';
import AppTeaser from '../components/AppTeaser.astro';
import Audience from '../components/Audience.astro';
import CategoriesMarquee from '../components/CategoriesMarquee.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base>
  <HeroSlider />

  <section class="section" aria-labelledby="intro-title">
    <div class="wrap grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <div data-reveal>
          <p class="kicker">Qui sommes-nous</p>
          <h2 id="intro-title" class="mt-3">Une initiative togolaise pour l'économie circulaire</h2>
        </div>
        <p class="lead mt-6 prose-width" data-reveal style="--d:80ms">
          Chaque jour, des objets encore utiles dorment dans nos maisons ou finissent jetés.
        </p>
        <p class="mt-4 prose-width text-forest/80" data-reveal style="--d:140ms">
          BUTUS aide les particuliers et les entreprises à leur donner une seconde vie : moins de déchets,
          plus de revenus, et des objets de qualité accessibles à tous.
        </p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:200ms">
          <a href="/mission" class="btn btn-dark">Notre mission</a>
          <a href="/contact" class="btn btn-outline">Nous contacter</a>
        </div>
      </div>
      <div data-reveal="zoom">
        <Loop />
      </div>
    </div>
  </section>

  <Pillars />
  <AppTeaser compact />
  <Audience />
  <CategoriesMarquee />
  <CtaBand />
</Base>
