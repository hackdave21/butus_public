---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Visual from '../components/Visual.astro';
import CtaBand from '../components/CtaBand.astro';

const constats = [
  { titre: 'Des objets oubliés', texte: 'Téléphones, meubles, vêtements : beaucoup d\'objets encore utiles restent rangés sans servir.' },
  { titre: 'Des déchets évitables', texte: 'Ce qui est jeté trop tôt finit dans nos rues et nos décharges, alors qu\'il pourrait servir encore.' },
  { titre: 'Des besoins réels', texte: 'Beaucoup de familles et de petits commerces cherchent des objets de qualité à un prix accessible.' },
];
const valeurs = [
  { titre: 'Simplicité', texte: 'Une application facile, même pour ceux qui n\'ont jamais acheté en ligne.', cls: 'bg-forest text-white' },
  { titre: 'Confiance', texte: 'BUTUS fait le lien entre acheteurs et vendeurs, et vérifie les boutiques.', cls: 'bg-yellow text-black' },
  { titre: 'Proximité', texte: 'Une initiative née au Togo, pensée pour les réalités locales.', cls: 'bg-green text-black' },
  { titre: 'Impact', texte: 'Chaque objet réutilisé, c\'est moins de déchets et plus d\'opportunités.', cls: 'bg-mist text-forest' },
];
---
<Base title="Notre mission | BUTUS" description="BUTUS est une initiative togolaise d'économie circulaire : donner une seconde vie aux objets et créer de nouvelles opportunités.">
  <PageHero
    kicker="Mission"
    title="Donner une seconde vie aux objets"
    lead="Et créer de nouvelles opportunités. Voici pourquoi BUTUS existe, et ce qui nous guide."
    image="mission"
    alt="Des mains échangent un objet d'occasion au milieu d'un marché animé de Lomé"
  />

  <!-- Le constat -->
  <section class="section" aria-labelledby="constat-title">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">Le constat</p>
        <h2 id="constat-title" class="mt-3 max-w-2xl">Trop d'objets utiles perdent leur valeur</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {constats.map((c, i) => (
          <article class="lift block-md bg-mist p-7" data-reveal style={`--d:${i * 100}ms`}>
            <span class="grid h-12 w-12 place-items-center rounded-full bg-forest font-display text-lg text-green" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-6 font-black">{c.titre}</h3>
            <p class="mt-2 text-forest/80">{c.texte}</p>
          </article>
        ))}
      </div>
      <!-- TODO: chiffres d'impact à fournir par BUTUS (ne pas inventer) -->
    </div>
  </section>

  <!-- La boucle -->
  <section class="section bg-forest text-white" aria-labelledby="boucle-title">
    <div class="wrap">
      <div class="prose-width">
        <div data-reveal>
          <p class="kicker text-white/75">L'économie circulaire</p>
          <h2 id="boucle-title" class="mt-3">Une boucle plutôt qu'une poubelle</h2>
        </div>
        <p class="lead mt-6 text-white/85" data-reveal style="--d:80ms">
          Dans une économie circulaire, un objet ne finit pas sa vie quand son premier propriétaire n'en veut plus.
        </p>
        <p class="mt-4 text-white/75" data-reveal style="--d:140ms">
          Il est vendu, acheté, réutilisé, réparé, puis valorisé. BUTUS rend cette boucle simple et sûre
          pour tout le monde : particuliers, boutiques et livreurs.
        </p>
        <a href="/ce-que-fait-butus" class="btn btn-yellow mt-8" data-reveal style="--d:200ms">Voir ce que fait BUTUS</a>
      </div>
    </div>
  </section>

  <!-- Valeurs -->
  <section class="section" aria-labelledby="valeurs-title">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">Nos valeurs</p>
        <h2 id="valeurs-title" class="mt-3">Ce qui nous guide</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {valeurs.map((v, i) => (
          <article class:list={['lift block-lg flex min-h-[15rem] flex-col justify-end p-7', v.cls]} data-reveal style={`--d:${i * 90}ms`}>
            <h3 class="text-[1.5rem] font-black uppercase">{v.titre}</h3>
            <p class="mt-3">{v.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Fondateur -->
  <section class="pb-20 md:pb-28" aria-labelledby="fondateur-title">
    <div class="wrap">
      <div class="grid overflow-hidden block-lg bg-mist md:grid-cols-[1fr_1.3fr]">
        <div class="h-72 md:h-auto md:min-h-[380px]" data-reveal="zoom">
          <!-- TODO: photo réelle du fondateur (public/images/pages/fondateur.jpg) — ne pas générer -->
          <Visual dir="pages" name="fondateur" alt="Portrait de Gedeon Essodonn BATAWOLO, fondateur de BUTUS" tone="green" />
        </div>
        <div class="flex flex-col justify-center p-7 md:p-12">
          <p class="kicker" data-reveal>Le fondateur</p>
          <h2 id="fondateur-title" class="mt-3 !text-[clamp(1.5rem,1.5vw+1rem,2rem)]" data-reveal style="--d:80ms">Gedeon Essodonn BATAWOLO</h2>
          <p class="mt-1 font-medium text-forest/70" data-reveal style="--d:120ms">Fondateur et CEO de BUTUS</p>
          <p class="mt-6 border-l-4 border-green pl-5 text-[1.125rem] leading-relaxed" data-reveal style="--d:160ms">
            Il a fondé BUTUS pour faire de la seconde main une solution simple, sûre et accessible à tous au Togo.
          </p>
          <!-- TODO: citation ou mot du fondateur, à fournir par BUTUS (ne pas inventer) -->
        </div>
      </div>
    </div>
  </section>

  <!-- Vision -->
  <section class="pb-20 md:pb-28" aria-labelledby="vision-title">
    <div class="wrap">
      <div class="relative overflow-hidden block-lg bg-forest px-7 py-14 text-white md:px-14 md:py-16" data-reveal>
        <p class="kicker text-white/75">Notre vision</p>
        <h2 id="vision-title" class="mt-3 max-w-3xl">Faire de la seconde main un réflexe au Togo</h2>
        <p class="lead mt-6 max-w-3xl text-white/85">
          Chaque objet utilisé plus longtemps, c'est moins de déchets, de nouvelles opportunités pour les vendeurs,
          les boutiques et les livreurs, et des objets de qualité à la portée de tous.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
