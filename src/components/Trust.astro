---
const engagements = [
  { titre: 'BUTUS fait le lien', texte: "L'acheteur et le vendeur passent par BUTUS. Nous confirmons chaque vente avant la livraison." },
  { titre: 'Des boutiques vérifiées', texte: 'Les boutiques sont contrôlées par notre équipe. Celles qui sont vérifiées affichent un badge.' },
  { titre: "L'état de chaque objet affiché", texte: 'Neuf, comme neuf, bon état, à réparer ou reconditionné : vous savez ce que vous achetez.' },
  { titre: 'Des livraisons confirmées', texte: 'Chaque livraison est validée par un code, une photo ou votre confirmation.' },
];
---
<section id="engagements" class="section bg-mist" aria-labelledby="trust-title">
  <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div data-reveal="left">
      <p class="kicker">Nos engagements</p>
      <h2 id="trust-title" class="mt-3">La confiance d'abord</h2>
      <p class="mt-5 prose-width text-forest/80">
        Acheter d'occasion doit être simple et sûr. L'application est construite autour de ces engagements.
      </p>
    </div>
    <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {engagements.map((e, i) => (
        <div class="trust-item relative pt-5" data-reveal style={`--d:${i * 90}ms`}>
          <span class="trust-line absolute left-0 top-0 h-1 rounded-full bg-green" aria-hidden="true"></span>
          <dt class="text-[1.1875rem] font-bold leading-snug">{e.titre}</dt>
          <dd class="mt-2 text-forest/80">{e.texte}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .trust-line { width: 0; transition: width 1s var(--ease-out) 0.3s; }
  .trust-item.is-in .trust-line, :global(html:not(.js)) .trust-line { width: 100%; }
  @media (prefers-reduced-motion: reduce) { .trust-line { width: 100%; transition: none; } }
</style>
