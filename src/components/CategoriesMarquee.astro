---
import { categories } from '../data/site';
interface Props { reverse?: boolean }
const { reverse = false } = Astro.props;
const rows = [categories, [...categories].reverse()];
---
<section class="overflow-hidden py-14 md:py-20" aria-labelledby="cat-title">
  <h2 id="cat-title" class="sr-only">Les catégories d'objets sur BUTUS</h2>
  <div class="flex flex-col gap-4">
    {rows.map((row, r) => (
      <div class="marquee" style={`--speed:${r === 0 ? 55 : 65}s`} aria-hidden={r === 1 ? 'true' : undefined}>
        <div class="marquee-track" style={(r === 1) !== reverse ? 'animation-direction:reverse' : ''}>
          {[0, 1].map((dup) => (
            <ul class="flex shrink-0 items-center gap-4 pr-4" aria-hidden={dup === 1 || r === 1 ? 'true' : undefined}>
              {row.map((c, i) => (
                <li class:list={[
                  'whitespace-nowrap rounded-full px-6 py-3 text-[1.125rem] font-bold md:text-[1.375rem]',
                  (i + r) % 4 === 0 ? 'bg-forest text-white' : (i + r) % 4 === 1 ? 'bg-yellow text-black' : (i + r) % 4 === 2 ? 'bg-mist text-forest' : 'bg-green text-black',
                ]}>{c}</li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
