---
import { nav, contact, pillars } from '../data/site';
const year = new Date().getFullYear();
const socials = contact.socials.filter((s) => s.href);
---
<footer class="relative overflow-hidden bg-forest text-white">
  <div class="wrap relative z-10 pt-16 md:pt-20">
    <!-- Appel à contact -->
    <div class="grid gap-8 border-b border-white/10 pb-14 md:grid-cols-[1.4fr_1fr] md:items-end">
      <div data-reveal>
        <p class="kicker text-white/70">Une question, un projet ?</p>
        <p class="font-display mt-4 max-w-xl text-[clamp(1.75rem,2.5vw+1rem,2.75rem)] uppercase">
          Construisons ensemble l'économie circulaire au Togo
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end" data-reveal style="--d:120ms">
        <a href="/contact" class="btn btn-yellow">Nous contacter</a>
        <a href={contact.whatsapp} class="btn btn-outline" target="_blank" rel="noopener">Écrire sur WhatsApp</a>
      </div>
    </div>

    <!-- Colonnes -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 py-14 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="text-[2.25rem] font-black tracking-tight leading-none" aria-label="BUTUS, accueil">
          <span class="text-green">B</span>UTUS
        </a>
        <p class="mt-4 max-w-xs text-white/70">Donner une seconde vie aux objets et créer de nouvelles opportunités.</p>
        <!-- Badge « bientôt sur Google Play » : pas un lien tant que l'app n'est pas publiée (logo monochrome, charte) -->
        <p class="store-badge mt-6 inline-flex items-center gap-3 rounded-2xl border border-white/25 bg-black px-4 py-2.5">
          <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M3.6 2.2c-.3.3-.4.7-.4 1.2v17.2c0 .5.1.9.4 1.2L13.3 12 3.6 2.2z"/>
            <path d="M16.6 8.7 5.2 2.1c-.6-.4-1.2-.4-1.6.1l9.7 9.8 3.3-3.3z" opacity=".8"/>
            <path d="M16.6 15.3 13.3 12l-9.7 9.8c.4.4 1 .5 1.6.1l11.4-6.6z" opacity=".8"/>
            <path d="m20.4 10.9-3.8-2.2-3.3 3.3 3.3 3.3 3.8-2.2c1.1-.6 1.1-1.6 0-2.2z" opacity=".6"/>
          </svg>
          <span class="flex flex-col leading-tight">
            <span class="text-[0.6875rem] font-medium uppercase tracking-wide text-white/70">Bientôt sur</span>
            <span class="text-[1.125rem] font-bold">Google Play</span>
          </span>
        </p>
      </div>

      <nav aria-label="Pied de page">
        <p class="font-bold">Le site</p>
        <ul class="mt-4 flex flex-col">
          {nav.map((l) => <li><a href={l.href} class="foot-link">{l.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <p class="font-bold">Ce que fait BUTUS</p>
        <ul class="mt-4 flex flex-col">
          {pillars.map((p) => <li><a href={`/ce-que-fait-butus#${p.id}`} class="foot-link">{p.verbe}</a></li>)}
        </ul>
      </div>

      <div class="col-span-2 lg:col-span-1">
        <p class="font-bold">Contact</p>
        <ul class="mt-4 flex flex-col">
          <li><a href={`mailto:${contact.email}`} class="foot-link">{contact.email}</a></li>
          <li><a href={contact.phoneHref} class="foot-link">{contact.phone}</a></li>
          <li><a href={contact.whatsapp} class="foot-link" target="_blank" rel="noopener">WhatsApp</a></li>
          <li class="py-1.5 text-white/70">{contact.city}</li>
        </ul>
        {socials.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {socials.map((s) => <li><a href={s.href} class="rounded-full border border-white/20 px-3 py-1.5 text-sm hover:bg-white hover:text-forest" target="_blank" rel="noopener">{s.label}</a></li>)}
          </ul>
        )}
      </div>
    </div>

    <div class="flex flex-col gap-4 border-t border-white/10 py-6 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} BUTUS. Tous droits réservés.</p>
      <div class="flex items-center gap-5">
        <a href="/mentions-legales" class="hover:text-white">Mentions légales</a>
        <button type="button" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2 text-white hover:bg-white hover:text-forest" data-to-top>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
          Haut de page
        </button>
      </div>
    </div>
  </div>

  <!-- Grand mot-symbole en filigrane -->
  <p class="footer-wordmark pointer-events-none select-none font-black uppercase leading-[0.75] text-white/[0.06]" aria-hidden="true">BUTUS</p>
</footer>

<style>
  .foot-link { display: inline-block; padding-block: 0.4rem; color: rgb(255 255 255 / 0.7); transition: color 0.2s, transform 0.2s var(--ease-out); }
  .foot-link:hover { color: #fff; transform: translateX(4px); }
  .footer-wordmark {
    font-size: clamp(6rem, 26vw, 24rem);
    letter-spacing: -0.05em;
    text-align: center;
    margin-bottom: -0.12em;
  }
  @media (prefers-reduced-motion: reduce) {
    .foot-link:hover { transform: none; }
  }
</style>
