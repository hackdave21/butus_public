---
// Captures statiques de l'application (public/images/app/<screen>.webp, format 9:20).
// Les captures d'origine sont dans brand/app/. L'image est décorative : le libellé est porté par Phone.astro.
interface Props {
  screen: 'accueil' | 'publier' | 'commander' | 'livraison-1' | 'livraison-2';
}
const { screen } = Astro.props;
---
<img src={`/images/app/${screen}.webp`} alt="" width="414" height="920" class="block h-full w-full object-cover object-top" loading="lazy" decoding="async" draggable="false" />
