---
// Schéma animé de la boucle de l'économie circulaire : les 5 piliers autour de BUTUS.
import { pillars } from '../data/site';
const R = 42; // rayon en % du conteneur
const nodes = pillars.map((p, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return { ...p, x: 50 + R * Math.cos(a), y: 50 + R * Math.sin(a) };
});
const colors = ['bg-forest text-white', 'bg-yellow text-black', 'bg-green text-black', 'bg-white text-forest ring-1 ring-forest/15', 'bg-black text-white'];
---
<div class="loop relative mx-auto aspect-square w-full max-w-[460px]" role="img" aria-label="La boucle BUTUS : vendre, acheter, réutiliser, réparer, valoriser, puis recommencer">
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="50" r="42" fill="none" stroke="#173A34" stroke-opacity="0.12" stroke-width="0.6" />
    <g class="spin-slow" style="transform-origin:50px 50px">
      <circle cx="50" cy="50" r="42" fill="none" stroke="#24B158" stroke-width="1.4" stroke-dasharray="6 4" stroke-linecap="round" />
    </g>
    <circle class="loop-draw" cx="50" cy="50" r="30" fill="none" stroke="#F2A900" stroke-width="1.2" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
  </svg>
  <div class="absolute left-1/2 top-1/2 grid h-[34%] w-[34%] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-forest shadow-[0_20px_40px_-20px_rgba(0,0,0,0.6)]" aria-hidden="true">
    <span class="text-[clamp(1.25rem,4vw,2rem)] font-black tracking-tight text-white"><span class="text-green">B</span>UTUS</span>
  </div>
  {nodes.map((n, i) => (
    <span
      class:list={['loop-node absolute -translate-x-1/2 -translate-y-1/2 rounded-full px-4 py-2 text-[0.9rem] font-bold shadow-[0_10px_24px_-14px_rgba(0,0,0,0.5)] md:text-[1rem]', colors[i]]}
      style={`left:${n.x}%;top:${n.y}%;--i:${i}`}
      aria-hidden="true"
    >{n.verbe}</span>
  ))}
</div>

<style>
  .loop-draw { transform: rotate(-90deg); transform-origin: 50px 50px; animation: draw 2.4s var(--ease-out) 0.4s forwards; }
  .loop-node { animation: pop 0.6s var(--ease-out) both; animation-delay: calc(0.6s + var(--i) * 0.15s); }
  @keyframes pop { from { opacity: 0; transform: translate(-50%, -50%) scale(0.6); } }
  @media (prefers-reduced-motion: reduce) {
    .loop-draw { animation: none; stroke-dashoffset: 0; }
    .loop-node { animation: none; }
  }
</style>
